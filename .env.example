# ── 校园网认证配置 ──────────────────────────────────────
# 将本文件重命名为 .env 并填入真实信息

# 网络连通性检测目标（默认百度）
TARGET_URL=https://www.baidu.com

# 校园网认证页面入口 URL。注意你需要自己在谷歌里试试是否能直接访问到登录认证页面
FALLBACK_URL=http://YOUR_PORTAL_SERVER:8080/eportal/index.jsp

# 校园网账号
PORTAL_USERNAME=your_username

# 校园网密码
PORTAL_PASSWORD=your_password
